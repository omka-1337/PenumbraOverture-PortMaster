# Penumbra: Overture - gamepad mapping
#
# The game is built around dragging things with the mouse: you hold the
# interact button and physically pull doors and drawers. That is why the right
# stick is the mouse and R1 is the left button - everything else follows from
# keeping those two usable at once.

back = tab
start = esc

a = space
b = r
x = f
y = g

l1 = mouse_right
r1 = mouse_left
l2 = lshift
r2 = lctrl
l3 = q
r3 = e

# The D-pad used to send the arrow keys, which this game never reads, so four
# buttons did nothing. The quick slots are nine and the pad has no room for
# nine, so left and right step through the slots that hold something, up uses
# the one you landed on, and down opens the notebook, which had no button
# at all before.
up = home
down = n
left = pageup
right = pagedown

left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

deadzone_scale = 6
